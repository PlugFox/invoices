# https://editorconfig.org
# Shared baseline for editors that are not VS Code or Zed.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# Keep in sync with `formatter.page_width` in analysis_options.yaml.
[*.dart]
max_line_length = 120

[*.{yaml,yml}]
indent_size = 2

[*.md]
# Trailing double spaces are a hard line break in Markdown.
trim_trailing_whitespace = false

[*.{ttf,pdf}]
insert_final_newline = false
trim_trailing_whitespace = false

[Makefile]
indent_style = tab
