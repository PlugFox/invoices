{
  // Use IntelliSense to learn about possible attributes.
  // Hover to view descriptions of existing attributes.
  // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Generate Invoice (config/config.yaml)",
      "request": "launch",
      "type": "dart",
      "program": "bin/main.dart",
      "cwd": "${workspaceFolder}",
      "env": {
        "ENVIRONMENT": "local"
      },
      "args": ["--input=config/config.yaml", "--output=invoice.pdf", "--locale=en_US"],
      "console": "debugConsole",
      "runTestsOnDevice": false,
      "toolArgs": []
    },
    {
      "name": "Generate Invoice (sample config.yaml)",
      "request": "launch",
      "type": "dart",
      "program": "bin/main.dart",
      "cwd": "${workspaceFolder}",
      "env": {
        "ENVIRONMENT": "local"
      },
      "args": ["--input=config.yaml", "--output=invoice.pdf", "--locale=en_US"],
      "console": "debugConsole",
      "runTestsOnDevice": false,
      "toolArgs": []
    },
    {
      "name": "Generate Invoice (prompt for input)",
      "request": "launch",
      "type": "dart",
      "program": "bin/main.dart",
      "cwd": "${workspaceFolder}",
      "env": {
        "ENVIRONMENT": "local"
      },
      "args": [
        "--input=${input:inputYaml}",
        "--output=${input:outputPdf}",
        "--template=${input:template}",
        "--font=${input:font}",
        "--locale=${input:locale}"
      ],
      "console": "debugConsole",
      "runTestsOnDevice": false,
      "toolArgs": []
    },
    {
      "name": "Print usage information",
      "request": "launch",
      "type": "dart",
      "program": "bin/main.dart",
      "cwd": "${workspaceFolder}",
      "env": {
        "ENVIRONMENT": "local"
      },
      "args": ["--help"],
      "console": "debugConsole",
      "runTestsOnDevice": false,
      "toolArgs": []
    },
    // https://pub.dev/packages/test
    {
      "name": "Unit Test",
      "request": "launch",
      "type": "dart",
      "program": "test/unit_test.dart",
      "cwd": "${workspaceFolder}",
      "env": {
        "ENVIRONMENT": "test"
      },
      "console": "debugConsole",
      "runTestsOnDevice": false,
      "templateFor": "test",
      "toolArgs": [
        "--color",
        "--debug",
        "--coverage=.coverage",
        "--reporter=expanded",
        "--platform=vm",
        "--file-reporter=json:.coverage/tests.json",
        "--timeout=30s",
        "--concurrency=12"
      ],
      "args": []
    }
  ],
  "inputs": [
    {
      "id": "inputYaml",
      "type": "promptString",
      "description": "Path to the invoice YAML file",
      "default": "config/config.yaml"
    },
    {
      "id": "outputPdf",
      "type": "promptString",
      "description": "Path to the generated PDF file",
      "default": "invoice.pdf"
    },
    {
      "id": "template",
      "type": "pickString",
      "description": "Template to use",
      "options": ["simple"],
      "default": "simple"
    },
    {
      "id": "font",
      "type": "pickString",
      "description": "Font to use",
      "options": ["openSans", "times", "helvetica", "courier"],
      "default": "openSans"
    },
    {
      "id": "locale",
      "type": "promptString",
      "description": "Locale used for date formatting",
      "default": "en_US"
    }
  ]
}
