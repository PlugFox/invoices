# Files excluded when publishing the package.
# Note: the bundled `fonts/` directory must stay, the templates load it at runtime.

# Files and directories created by pub
.dart_tool/
.packages
build/

# Directory created by dartdoc
doc/api/

# dotenv environment variables file
.env*

# Produced by the --dump-info flag.
*.info.json

# Editor and toolchain configuration
.vscode/
.zed/
.editorconfig
mise.toml

# Coverage and test artifacts
.coverage/
coverage/
test/*.json

# Local secrets and real invoice data
credentials.json
config/

# Generated invoices
*.pdf
